[Unit]
Description=Tozyw consistent encrypted SQLite backup
Wants=network-online.target
After=network-online.target tozyw.service

[Service]
Type=oneshot
User=tozyw
Group=tozyw
EnvironmentFile=/etc/tozyw/backup.env
Environment=HOME=/srv/tozyw
ExecStart=/opt/tozyw/current/ops/scripts/run_backup.sh
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/tozyw/data /var/backups/tozyw /var/log/tozyw /srv/tozyw/.cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
