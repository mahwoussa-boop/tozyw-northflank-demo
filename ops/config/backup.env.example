# انسخ هذا الملف إلى /etc/tozyw/backup.env على الخادم فقط، ثم عيّن المالك root والصلاحية 0600.
# لا تحفظ هذا الملف بالقيم الحقيقية في Git.

TOZYW_DATA_DIR=/srv/tozyw/data
TOZYW_BACKUP_DIR=/var/backups/tozyw
TOZYW_BACKUP_RETENTION_DAYS=30
TOZYW_BACKUP_LABEL=tozyw
TOZYW_DATABASES="pricing_v18.db perfume_pricing.db"

# يجب أن يكون هذا مسار rclone remote من نوع crypt وليس remote Google Drive الخام.
RCLONE_REMOTE=tozyw-crypt:archives
RCLONE_CONFIG=/etc/tozyw/rclone.conf

# خزّنه عبر OCI Vault أو مدير أسرار الخادم وامنحه للوحدة فقط، لا تضعه في Git.
RCLONE_CONFIG_PASS=REPLACE_AT_BOOTSTRAP
