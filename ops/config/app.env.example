# انسخ إلى /etc/tozyw/app.env بصلاحية 0600 على الخادم فقط.
# لا تدرج قيماً حقيقية ضمن هذا الملف في Git أو سجلات النشر.

# اربط كل مفتاح فعلي عبر OCI Vault أو أداة الأسرار المعتمدة في مرحلة bootstrap.
OPENROUTER_API_KEY=
MAKE_API_KEY=
SALLA_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# متغير مدعوم في utils/data_paths.py؛ يمنع الكتابة في data/ ضمن الإصدار المتبدل.
DATA_DIR=/srv/tozyw/data
