# انسخ إلى /etc/tozyw/release.env على الخادم بصلاحية 0600.
# استخدم رابط SSH مع مفتاح نشر read-only محفوظ محلياً على الخادم.
# لا تستخدم المستودع المؤرشف mahwoussa-boop/tozyw هدفاً للنشر، ولا تضع PAT في هذا الملف.

TOZYW_REPOSITORY_URL=git@github.com:OWNER/tozyw-production.git
TOZYW_APP_ROOT=/opt/tozyw
TOZYW_DATA_DIR=/srv/tozyw/data
TOZYW_SERVICE_NAME=tozyw.service
