# انسخ إلى /etc/tozyw/release.env على الخادم بصلاحية 0600.
# يجب أن يشير إلى مستودع خاص غير مؤرشف أو URL وصول للقراءة محدود الصلاحية.
# لا تستخدم المستودع المؤرشف mahwoussa-boop/tozyw هدفاً للنشر.

TOZYW_REPOSITORY_URL=https://github.com/OWNER/tozyw-production.git
TOZYW_APP_ROOT=/opt/tozyw
TOZYW_DATA_DIR=/srv/tozyw/data
TOZYW_SERVICE_NAME=tozyw.service
