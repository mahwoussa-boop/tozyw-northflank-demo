# ─────────────────────────────────────────────────────────────
#  مفتاح الذكاء الاصطناعي (اختياري) — OpenRouter
#  التطبيق يعمل كاملاً بدونه؛ تفعيله يحسّن حسم «تحت المراجعة».
#
#  للتفعيل:
#   1) انسخ هذا الملف وسمّه  .env  (بدون امتداد آخر)
#   2) ضع مفتاحك الحقيقي مكان القيمة أدناه
#   3) أعد تشغيل التطبيق
#
#  ⚠️ لا تشارك ملف .env الحقيقي مع أحد — يحتوي مفتاحك الخاص.
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=ضع-مفتاحك-هنا

# ─────────────────────────────────────────────────────────────
#  روابط Make.com Webhooks (التكامل مع سلة)
#  - WEBHOOK_NEW_PRODUCTS : سيناريو «إضافة منتجات جديدة لسلة»
#       (Hook 3871450 — منطقة eu2.make.com)
#  - WEBHOOK_UPDATE_PRICES: سيناريو «تحديث الأسعار»
#  إن تُركت فارغة يستخدم الكود قيمة placeholder ولن يُرسِل فعلياً.
# ─────────────────────────────────────────────────────────────
WEBHOOK_NEW_PRODUCTS=https://hook.eu2.make.com/ضع-توكن-hook-3871450-هنا
WEBHOOK_UPDATE_PRICES=https://hook.eu2.make.com/ضع-توكن-سيناريو-تحديث-الأسعار-هنا

# ─────────────────────────────────────────────────────────────
#  Salla Admin API (اختياري) — إنشاء الماركة/التصنيف عند غيابها
#  عند توفّر التوكن: إن غاب brand_id/category_id يبحث الكود في سلة
#  بالاسم ثم يُنشئ الماركة/التصنيف ويستخدم الـid الناتج (create-if-missing).
#  إن تُرك فارغاً يعود السلوك للافتراضي (يُحذف الحقل من الـpayload).
# ─────────────────────────────────────────────────────────────
SALLA_ACCESS_TOKEN=
# SALLA_API_BASE=https://api.salla.dev/admin/v2

# ─────────────────────────────────────────────────────────────
#  Supabase (اختياري) — مرآة «مصدر الحقيقة» لمزامنة الماركات/التصنيفات
#  sync_store_maps يكتب store_brands/store_categories (on conflict salla_id).
#  بلا هذين المتغيّرين تبقى المزامنة على CSV فقط (القراءة الحارّة دائماً CSV).
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
#  Google Custom Search (اختياري) — شعار الماركة الجديدة
#  سلة تفرض شعاراً لإنشاء ماركة جديدة. عند توفّر المفتاحين يسحب الكود
#  رابط شعار للماركة بالاسم من بحث صور Google ويمرّره في حمولة Make
#  ضمن «صورة شعار الماركة» (مكاش: مكالمة واحدة لكل ماركة).
#  بلا المفتاحين يُحذف الحقل من الـpayload (يعود السلوك للافتراضي).
#  GOOGLE_CSE_KEY : مفتاح Google API (Programmable Search / Custom Search JSON).
#  GOOGLE_CSE_ID  : معرّف محرك البحث المبرمَج (cx) — فعّل «بحث الصور» فيه.
# ─────────────────────────────────────────────────────────────
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
