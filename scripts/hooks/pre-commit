#!/bin/sh
# ==========================================================================
# مهووس — بوّابة ما قبل الـcommit: امنع أي commit ما لم تكن الاختبارات خضراء.
#
# هذه هي **النسخة المرجعية المتتبَّعة**. النسخة العاملة في .git/hooks/pre-commit
# (غير متتبَّعة بطبيعة git). للتركيب على جهاز جديد أو بعد استرجاع نسخة احتياطية:
#     cp scripts/hooks/pre-commit .git/hooks/pre-commit
#     chmod +x .git/hooks/pre-commit
#
# الأساس الأخضر المعروف: 1,406 passed (2026-07-25، main).
# للطوارئ القصوى فقط: git commit --no-verify
# ==========================================================================

# ── حلّ مسار المفسّر من **المستودع الرئيسي** لا من مجلد العمل الحالي ──────
# العطب المُصلَح (2026-07-25): كان PY=".venv/Scripts/python.exe" مساراً نسبياً.
# داخل شجرة عمل (git worktree) لا يوجد .venv — يعيش في الشجرة الرئيسية وحدها —
# فيصحّ شرط «لم أجد المفسّر» ويُنفَّذ exit 0 ⇒ **الإيداع يمرّ وصفر اختبار يُشغَّل**.
# أي أن كل كوميت داخل شجرة عمل كان يتخطّى البوّابة كلها بتحذير سطرٍ واحد.
# git rev-parse --git-common-dir يعطي .git للشجرة الرئيسية ومساراً مطلقاً إليها
# من أي شجرة عمل، فـdirname منه = جذر المستودع الرئيسي في الحالتين.
ROOT=$(cd "$(dirname "$(git rev-parse --git-common-dir)")" 2>/dev/null && pwd)
PY="$ROOT/.venv/Scripts/python.exe"

if [ ! -f "$PY" ]; then
  echo "⚠️  pre-commit: لم أجد المفسّر في $PY — تخطّي بوّابة الاختبارات."
  echo "   فعّل الـvenv أولاً. هذا الكوميت يمرّ **بلا أي اختبار**."
  exit 0
fi

# pytest يُشغَّل من مجلد العمل الحالي عمداً: داخل شجرة عمل نريد اختبار كودها
# هي بمفسّر الشجرة الرئيسية، لا اختبار كود الشجرة الرئيسية.
echo "🧪 pre-commit: تشغيل حزمة اختبارات مهووس (قد تأخذ دقيقة)..."
"$PY" -m pytest -q --ignore=tests/test_api.py
STATUS=$?

if [ "$STATUS" -ne 0 ]; then
  echo ""
  echo "⛔ الاختبارات فشلت — تمّ منع الـcommit. أصلح ثم أعد المحاولة."
  echo "   (للطوارئ القصوى فقط: git commit --no-verify)"
  exit 1
fi

echo "✅ الاختبارات خضراء — يُسمح بالـcommit."
exit 0
