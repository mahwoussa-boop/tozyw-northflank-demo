                    }
                ],
                "expect": [
                    {
                        "name": "id",
                        "type": "select",
                        "label": "Select Product",
                        "required": true
                    },
                    {
                        "name": "quantity",
                        "type": "uinteger",
                        "label": "New product quantity ",
                        "required": true
                    },
                    {
                        "name": "unlimited_quantity",
                        "type": "boolean",
                        "label": "If this product has unlimited quantity",
                        "required": true
                    }
                ]
            }
        }
