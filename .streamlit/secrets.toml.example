# .streamlit/secrets.toml.example — قالب الأسرار (أسماء فقط، بلا قيم)
# ───────────────────────────────────────────────────────────────
# للاستخدام: انسخ هذا الملف إلى  .streamlit/secrets.toml  ثم املأ القيم.
# الملف الحقيقي secrets.toml مُستبعَد من git (لا يُرفع أبداً).
#
# كل المفاتيح اختيارية: المسار الأساسي (لوحة/تسعير/مفقودات) يعمل بدونها
# تماماً (use_ai=False افتراضياً، ولا إرسال لـ Make دون إذن مباشر).
# على Railway: لا تستخدم هذا الملف — ضع نفس الأسماء في «Variables» بلوحة Railway.

# ── الذكاء الاصطناعي (اختياري — لتفعيل تحقّق سلة المراجعة) ──
# GEMINI_API_KEYS = ["YOUR_KEY_1", "YOUR_KEY_2"]
# GEMINI_API_KEY = "YOUR_KEY"
# OPENROUTER_API_KEY = "YOUR_KEY"
# COHERE_API_KEY = "YOUR_KEY"

# ── Make.com Webhooks (اختياري — للإرسال الخارجي، لا يُفعَّل دون إذنك المباشر) ──
# WEBHOOK_UPDATE_PRICES = "https://hook.eu.make.com/XXXX"
# WEBHOOK_NEW_PRODUCTS = "https://hook.eu.make.com/YYYY"
